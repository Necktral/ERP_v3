# Copie a un archivo fuera del repositorio, reemplace todos los valores y ejecute:
#   set -a; . /ruta/segura/prod.env; set +a
#   docker compose -f compose.prod.yaml config --quiet
#   docker compose -f compose.prod.yaml up -d --build

POSTGRES_DB=REEMPLAZAR
POSTGRES_USER=REEMPLAZAR
POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_LARGO
DJANGO_SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO
AUDIT_HMAC_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_DISTINTO
POS_EDGE_CONNECTOR_SHARED_SECRET=REEMPLAZAR_CON_BASE64_ALEATORIO
DASH_SESSION_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DISTINTO

DJANGO_ALLOWED_HOSTS=erp.ejemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.ejemplo.com
DJANGO_CORS_ALLOWED_ORIGINS=https://erp.ejemplo.com

# El frontend sólo escucha en loopback; publique TLS mediante un reverse proxy administrado.
ERP_HTTP_BIND=127.0.0.1
ERP_HTTP_PORT=8080
